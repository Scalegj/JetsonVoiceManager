[DEFAULT]
# Jetson IP address (required)
# Replace with your Jetson's actual IP address
jetson_ip = 192.168.1.100

# Ollama model to use
ollama_model = llama3.2:3b

# Audio settings
silence_threshold = 500.0
silence_duration = 2.5

# Interrupt settings
# Set to false to disable interrupt detection and save resources
enable_interrupts = true
# RMS threshold for interrupt detection (slightly higher than silence_threshold)
interrupt_threshold = 600.0

# Uncomment and customize if you want a different system prompt
# system_prompt = You are a helpful AI assistant.

# Set to true to enable streaming by default
streaming = false
